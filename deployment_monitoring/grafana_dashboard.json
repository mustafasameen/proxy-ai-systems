{"dashboard": {"uid": "iris-monitor", "title": "Iris classifier: live predictions", "timezone": "browser", "time": {"from": "now-30m", "to": "now"}, "refresh": "10s", "graphTooltip": 1, "panels": [{"id": 1, "type": "timeseries", "title": "Prediction activity: cumulative predictions by class", "description": "gradio_predictions_total, one series per predicted species. Each step up is one prediction made in the app.", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 10}, "datasource": {"type": "prometheus", "uid": "prom"}, "targets": [{"refId": "A", "expr": "sum by (prediction_type) (gradio_predictions_total)", "legendFormat": "{{prediction_type}}", "interval": "5s"}], "fieldConfig": {"defaults": {"unit": "none", "decimals": 0, "min": 0, "custom": {"drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "axisSoftMin": 0, "gradientMode": "none"}, "color": {"mode": "fixed", "fixedColor": "#555555"}}, "overrides": [{"matcher": {"id": "byName", "options": "setosa"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#0072B2"}}]}, {"matcher": {"id": "byName", "options": "versicolor"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#E69F00"}}]}, {"matcher": {"id": "byName", "options": "virginica"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#009E73"}}]}]}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi"}}, "interval": "5s", "maxDataPoints": 2000}, {"id": 2, "type": "timeseries", "title": "Prediction confidence: latest prediction", "description": "gradio_prediction_confidence, the highest class probability of the most recent prediction (a gauge, so it holds its last value between predictions). Dashed line at 0.7.", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 10}, "datasource": {"type": "prometheus", "uid": "prom"}, "targets": [{"refId": "A", "expr": "gradio_prediction_confiden